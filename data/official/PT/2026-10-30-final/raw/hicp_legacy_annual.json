ver a calendar year compared to the average of the monthly consumer price indices over the previous calendar year</li></ul><p>Please note that this dataset is discontinued and replaced by <a href=\"https://ec.europa.eu/eurostat/databrowser/bookmark/f7a8b7e0-9b0e-4652-a82b-ad4ffc058b1b?lang=en&amp;createdAt=2026-05-20T13:25:22Z\" rel=\"noopener noreferrer\" target=\"_blank\">prc_hicp_ainr</a></p>","id":"PRC_HICP_AIND","agencyId":"ESTAT","version":"1.0","datastructure":{"id":"PRC_HICP_AIND","agencyId":"ESTAT","version":"59.0"},"annotation":[{"type":"CREATED","date":"2015-11-16T10:20:47+0100"},{"type":"DISSEMINATION_DOI_XML","title":"<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/PRC_HICP_AIND\"><skos:notation rdf:datatype=\"http://purl.org/spar/datacite/doi\">10.2908/PRC_HICP_AIND</skos:notation><dct:creator rdf:resource=\"http://publications.europa.eu/resource/authority/corporate-body/ESTAT\"/><dct:issued rdf:datatype=\"http://www.w3.org/2001/XMLSchema#date\">2023-01-23</dct:issued></adms:Identifier></adms:identifier>"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf","text":"Information note"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"},{"type":"DISSEMINATION_OBJECT_TYPE","title":"DATASET"},{"type":"DISSEMINATION_TIMESTAMP_DATA","date":"2026-02-06T23:00:00+0100"},{"type